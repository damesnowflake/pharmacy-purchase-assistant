# 프론트엔드(Vite)에 노출되는 공개 값만 여기 둔다. NFR-07: 관리자 키·공휴일 API 키는
# 절대 여기(또는 커밋되는 .env 파일)에 넣지 않는다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- 아래는 서버 전용 값이며 이 파일에 채우지 않는다. Supabase 프로젝트 설정 또는
# scripts/*.ts 실행 시 셸 환경변수로만 주입한다 ---
# SUPABASE_SERVICE_ROLE_KEY=   # scripts/issue_account.ts 등 운영 스크립트 전용
# HOLIDAY_API_SERVICE_KEY=     # 공공데이터포털 한국천문연구원 특일 정보 API 키 (supabase/functions/holiday-sync)
